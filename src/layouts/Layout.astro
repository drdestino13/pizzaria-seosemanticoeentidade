---
import { NEGOCIO, SAME_AS } from "../data/negocio";

interface Props {
  title: string;
  description?: string;
  jsonLd?: object;
}
const { title, description = `${NEGOCIO.nome} — pizzaria de forno a lenha na ${NEGOCIO.bairro}, ${NEGOCIO.cidade}.`, jsonLd } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
    <style is:global>
      @import "../styles/global.css";
    </style>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="banner">
      Demonstração educacional (aula "As 3 Eras do SEO") — {NEGOCIO.nome} aplicando SEO Semântico. Não é um negócio real.
    </div>
    <header class="site-header">
      <a href="/" class="logo">{NEGOCIO.nome}</a>
      <nav>
        <a href="/">Início</a>
        <a href="/pizza-artesanal/">Pizza Artesanal</a>
        <a href="/cardapio/">Cardápio</a>
        <a href="/blog/">Blog</a>
        <a href="/sobre-o-ze/">Sobre o Zé</a>
        <a href="/faq/">Perguntas Frequentes</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <section class="reviews-section">
      <div class="reviews-section-inner">
        <div class="reviews-heading">
          <span class="score">4,8</span>
          <span class="stars">★★★★★</span>
          <span class="count">227 avaliações no Google</span>
        </div>
        <div class="reviews-grid">
          <div class="review-card">
            <div class="stars">★★★★★</div>
            <div class="author">Marina Costa</div>
            <div class="date">há 2 semanas</div>
            <p>A massa de 48 horas faz toda diferença. Borda leve, nada pesada. Virou fixa aqui em casa.</p>
          </div>
          <div class="review-card">
            <div class="stars">★★★★★</div>
            <div class="author">Rafael Nogueira</div>
            <div class="date">há 1 mês</div>
            <p>Forno a lenha de verdade, dá pra sentir o defumado leve na borda. Melhor napolitana da Vila Mariana.</p>
          </div>
          <div class="review-card">
            <div class="stars">★★★★☆</div>
            <div class="author">Juliana Prado</div>
            <div class="date">há 1 mês</div>
            <p>Pedi a vegana e surpreendeu, queijo vegetal bem feito. Entrega demorou uns 10 min a mais que o previsto.</p>
          </div>
          <div class="review-card">
            <div class="stars">★★★★★</div>
            <div class="author">Eduardo Salles</div>
            <div class="date">há 2 meses</div>
            <p>Fui atrás depois de ler sobre a fermentação natural no site. Bateu a expectativa.</p>
          </div>
        </div>
      </div>
    </section>
    <footer class="site-footer">
      <div class="footer-col">
        <div class="map-embed">
          <iframe
            src={`https://www.google.com/maps?q=${encodeURIComponent(NEGOCIO.endereco)}&output=embed`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`Mapa: ${NEGOCIO.endereco}`}
          ></iframe>
        </div>
      </div>
      <div class="footer-col">
        <strong>{NEGOCIO.nome}</strong><br />
        {NEGOCIO.endereco}<br />
        Tel: {NEGOCIO.telefoneExibicao}<br />
        {NEGOCIO.horario}
      </div>
      <div class="footer-col">
        <strong>Perfis oficiais (sameAs)</strong>
        <ul>
          {SAME_AS.map((url) => <li><a href={url} rel="me noopener" target="_blank">{new URL(url).hostname}</a></li>)}
        </ul>
      </div>
      <div class="footer-col">
        <strong>Guias reais da região</strong>
        <ul>
          <li>Google Perfil da Empresa</li>
          <li>Guia Gastronômico Vila Mariana</li>
        </ul>
      </div>
    </footer>
  </body>
</html>
