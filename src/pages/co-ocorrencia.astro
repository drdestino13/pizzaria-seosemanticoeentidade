---
import Layout from "../layouts/Layout.astro";
import ConceptTag from "../components/ConceptTag.astro";
import CompareLink from "../components/CompareLink.astro";
---
<Layout title="Massa, Fermentação e Forno a Lenha | Pizzaria do Zé">
  <ConceptTag bloco="Semântico" numero={1} nome="Co-ocorrência Semântica" />
  <h1>Massa, Fermentação e Forno a Lenha</h1>
  <div class="natural-copy">
    Nossa massa descansa 48 horas em fermentação natural antes de ir pro forno a
    lenha a 400°C, com mussarela de búfala e borda alta e aerada.
  </div>
  <p>
    Falamos de massa, fermentação, forno a lenha e borda quando o assunto é pizza
    artesanal — são esses os termos que naturalmente aparecem juntos quando alguém
    de verdade fala sobre o assunto, sem precisar repetir "pizza" quarenta vezes.
  </p>
  <CompareLink slug="co-ocorrencia" />
</Layout>
