---
import Layout from "../layouts/Layout.astro";
import { NEGOCIO } from "../data/negocio";
---
<Layout title={`${NEGOCIO.nome} — Pizza Artesanal de Forno a Lenha em ${NEGOCIO.bairro}, ${NEGOCIO.cidade}`}>
  <h1>{NEGOCIO.nome}</h1>
  <p><strong>Pizza artesanal de forno a lenha na {NEGOCIO.bairro}, {NEGOCIO.cidade}/{NEGOCIO.estado}.</strong></p>

  <p>
    <strong>{NEGOCIO.nome}</strong><br />
    {NEGOCIO.endereco}<br />
    Tel: {NEGOCIO.telefoneExibicao} · {NEGOCIO.horario}
  </p>
</Layout>
