---
import Layout from "../layouts/Layout.astro";
import { NEGOCIO } from "../data/negocio";
---
<Layout title={`Fale Conosco | ${NEGOCIO.nome}`}>
  <h1>Fale Conosco</h1>
  <img class="photo" src="https://images.unsplash.com/photo-1594007654729-407eedc4be65?w=1000&q=80" alt="Pizza da pizzaria" loading="lazy" />
  <p>{NEGOCIO.telefoneExibicao}</p>
  <h2>Endereço</h2>
  <p>{NEGOCIO.endereco}</p>
  <h2>Horário</h2>
  <p>{NEGOCIO.horario}</p>
  <h2>WhatsApp</h2>
  <p>Também atendemos pelo mesmo número via WhatsApp, das 18h às 23h.</p>
</Layout>
