---
import Layout from "../layouts/Layout.astro";
import ConceptTag from "../components/ConceptTag.astro";
import CompareLink from "../components/CompareLink.astro";
import { NEGOCIO } from "../data/negocio";
---
<Layout title="Nosso Domínio e Nossa Marca | Pizzaria do Zé">
  <ConceptTag bloco="Tradicional" numero={3} nome="Exact Match Domain" />
  <h1>Nosso Domínio e Nossa Marca</h1>
  <p>
    Nosso domínio é o nome da nossa própria marca — <code>pizzaria-seosemanticoeentidade.vercel.app</code> —
    não uma palavra-chave genérica tipo "melhorpizzadesaopaulo.com.br". Construímos a
    reputação em cima do nome <strong>{NEGOCIO.nome}</strong>, e é esse nome que o
    Google aprende a confiar, não o texto da URL.
  </p>
  <CompareLink slug="dominio" />
</Layout>
